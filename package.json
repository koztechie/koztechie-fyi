{
  "name": "koztechie-fyi",
  "version": "0.0.0",
  "private": true,
  "description": "ВУЗОЛ-0 — архівний вузол koztechie.fyi. Статика на Eleventy, 0 байт JS.",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "eleventy --serve",
    "build": "node scripts/sync-palette-ratios.mjs && eleventy && node scripts/typography.mjs --fix && node scripts/optimize-og.mjs && node scripts/bundle-styles.mjs && node scripts/postbuild.mjs",
    "check": "node scripts/check.mjs && node scripts/typography.mjs && node scripts/palette-check.mjs",
    "check:determinism": "node scripts/check-determinism.mjs",
    "check:node-pin": "node scripts/check-node-pin.mjs",
    "check:deploy-pin": "node scripts/check-deploy-pin.mjs",
    "check:lighthouse-mobile": "node scripts/check-lighthouse-mobile.mjs",
    "chaos:scroll-labels": "node scripts/chaos-scroll-labels.mjs",
    "qa:all": "node scripts/qa-all.mjs",
    "plan-lint": "node scripts/plan-lint.mjs docs/PLAN.md",
    "live-probe": "node scripts/live-probe.mjs",
    "live-probe:light": "node scripts/live-probe-light.mjs",
    "dependabot:validate": "node scripts/validate-dependabot.mjs",
    "email-dns-gate": "node scripts/email-dns-gate.mjs",
    "size": "node scripts/size-budget.mjs",
    "palette": "node scripts/palette-check.mjs",
    "validate": "node scripts/validate-content.mjs content/",
    "linkcheck": "node scripts/linkcheck.mjs",
    "linkcheck:external": "node scripts/external-linkcheck.mjs",
    "voice-lint": "node scripts/voice-lint.mjs content/"
  },
  "dependencies": {
    "@11ty/eleventy": "3.1.8"
  }
}
