{#- page.njk: лейаут статичної сторінки.
    Крок 116. docs/ARCHITECTURE.md, content-model.md §5.5.
    Призначення: /manifest/, /now/, /colophon/, /contact/, /privacy/.
    h1 + текст. -#}
{% extends "base.njk" %}
{%- set strings = strings[lang] | default(strings.uk) %}

{% block title %}<title>{{ title }} — {{ strings.site.name }}</title>{% endblock %}

{% block description %}
{%- if summary %}
<meta name="description" content="{{ summary }}">
{%- endif %}
{% endblock %}

{% block content %}
<article class="page page--{{ page.fileSlug | default('document') }}">
  <header class="page-header">
    <h1>{{ title }}</h1>
    {%- if updated %}
    <p class="page-updated"><span>{{ strings.now.updated }}</span> <time datetime="{{ updated | isoDate }}">{{ updated | isoDate }}</time></p>
    {%- endif %}
  </header>
  {%- if content_warning %}
  {%- set contentWarnings = [content_warning] if content_warning is string else content_warning %}
  <aside class="content-warning" role="note">
    <p>{{ strings.post.warning_prefix }} {% for warning in contentWarnings %}{{ strings.post.warnings[warning] or warning }}{% if not loop.last %}; {% endif %}{% endfor %}.</p>
  </aside>
  {%- endif %}
  <div class="page-body">
    {{ content | safe }}
  </div>
</article>
{% endblock %}
