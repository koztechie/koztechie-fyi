{#- list.njk: лейаут списку (індекси розділів).
    Крок 115. docs/ARCHITECTURE.md (дерево шаблонів).
    Призначення: /blog/, /practice/, /cemetery/, /poetry/ — індекси.
    Структура: h1 → intro (опційно) → список → пагінація.
    Пагінація (DECISIONS.md §9.3): «Сторінка 1, 2, 3…» + лічильник
    («Усього дописів: N» для блогу, спек 2026-11-05; решта — старий формат).
    Без «∞», без infinite scroll (§9.2).
    entry-line у списках НЕ виводиться (design-system.md §4).
    Тексти — зі словників (кроки 117–119). Хардкод заборонено (крок 118).
    Джерела елементів (крок 131):
    - pagination.items — коли задана пагінація (Eleventy);
    - collections[section] — коли pagination немає. Порожня колекція НЕ
      блокує генерацію сторінки (пагінація на порожніх даних не пише
      вихідний файл — виявлено на кроці 131).
    Мовна ізоляція: лише записи цієї мови. -#}
{% extends "base.njk" %}
{%- set strings = strings[lang] | default(strings.uk) %}

{% block title %}<title>{{ title }} — {{ strings.site.name }}</title>{% endblock %}

{% block description %}
{%- if summary %}
<meta name="description" content="{{ summary }}">
{%- endif %}
{% endblock %}

{% block content %}
{%- set pageLang = lang | default("uk") -%}
{%- set items = [] -%}
{%- if pagination and pagination.items.length -%}
  {%- set items = pagination.items -%}
{%- elif section and collections[section] -%}
  {%- for it in collections[section] -%}
    {%- if (it.data.lang | default("uk")) === pageLang and it.data.date -%}
      {%- set items = items.concat([it]) -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
<article class="list list--{{ section | default('section') }}">
  <header class="list-header">
    <h1>{{ title }}</h1>
    {%- if intro %}
    <p class="list-intro">{{ intro }}</p>
    {%- endif %}
  </header>
  {%- if content %}
  <div class="list-body">{{ content | safe }}</div>
  {%- endif %}

  {%- if items.length %}
  {#- Загальна кількість: конкатенація всіх сторінок пагінації
      (set на атрибут об'єкта nunjucks не компілює).
      Без пагінації all = items. -#}
  {%- set all = [] -%}
  {%- if pagination -%}
    {%- for pg in pagination.pages %}{% set all = all.concat(pg) %}{% endfor %}
  {%- else -%}
    {%- set all = items -%}
  {%- endif -%}
  <ol class="archive-list index-list index-list--{{ section | default('section') }}">
    {%- for item in items %}
    {%- if item.data.draft !== true and item.url %}
    <li>
      <span class="index-entry__number">{{ item.data.entry }}</span>
      <div class="index-entry__body">
        <a href="{{ item.url }}">{{ item.data.title }}</a>
        {%- if section === "cemetery" and item.data.epitaph %}
        <p class="index-entry__summary">{{ item.data.epitaph }}</p>
        {%- elif section === "practice" and item.data.summary %}
        <p class="index-entry__summary">{{ item.data.summary }}</p>
        {%- endif %}
      </div>
      <dl class="index-entry__facts">
        {%- if section === "cemetery" and item.data.period %}
        <div><dt>{{ strings.list.period_label }}</dt><dd>{{ item.data.period }}</dd></div>
        {%- elif item.data.date %}
        <div><dt>{{ strings.list.date_label }}</dt><dd><time datetime="{{ item.data.date.toISOString().slice(0, 10) }}">{% if pageLang === "en" %}{{ item.data.date | enDate }}{% else %}{{ item.data.date | ukDate }}{{ strings.site.date_suffix }}{% endif %}</time></dd></div>
        {%- endif %}
        {%- if section === "cemetery" and item.data.cause %}
        <div><dt>{{ strings.list.cause_label }}</dt><dd>{{ item.data.cause }}</dd></div>
        {%- endif %}
      </dl>
    </li>
    {%- endif %}
    {%- endfor %}
  </ol>

  {%- if pagination %}
  {%- set totalPages = pagination.pages.length -%}
  {%- set current = pagination.pageNumber + 1 -%}
  {%- if totalPages > 1 %}
  <nav class="pagination" aria-label="{{ strings.list.pagination_label }}">
    {%- if current > 1 %}
    <a href="{{ pagination.hrefs[current - 2] }}" rel="prev">{{ strings.list.prev }}</a>
    {%- endif %}
    <span class="pagination__pages">
      {%- for href in pagination.hrefs %}
      {%- if loop.index === current %}
      <span class="current" aria-current="page">{{ loop.index }}</span>
      {%- else %}
      <a href="{{ href }}">{{ loop.index }}</a>
      {%- endif %}
      {%- endfor %}
    </span>
    {%- if current < totalPages %}
    <a href="{{ pagination.hrefs[current] }}" rel="next">{{ strings.list.next }}</a>
    {%- endif %}
  </nav>
  {%- endif %}
  {%- endif %}
  {%- if count_label and count_unit %}
  <p class="list-count">{{ count_label }}: {{ all.length }} {{ all.length | plural(count_unit) }}.</p>
  {%- elif count_label %}
  <p class="list-count">{{ count_label }}: {{ all.length }}</p>
  {%- else %}
  <p class="list-count">{{ strings.list.count }} {{ all.length }} {{ all.length | plural(strings.list.count_unit) }}</p>
  {%- endif %}
  {%- else %}
  <p class="list-empty">{{ empty_label or strings.list.empty }}</p>
  {%- if pageLang === "en" -%}
    {%- set ukSection = [] -%}
    {%- for it in collections[section] -%}
      {%- if (it.data.lang | default("uk")) === "uk" -%}
        {%- set ukSection = ukSection.concat([it]) -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if ukSection.length %}
  <p><a href="/{{ section }}/" hreflang="uk">{{ strings.list.read_uk }}</a></p>
    {%- endif %}
  {%- endif %}
  {%- endif %}
</article>
{% endblock %}
