{#- stub.njk: заглушка перекладу (DECISIONS §35.2, ARCHITECTURE §4).
    Формат і тексти — зі словників (strings.stub), хардкод заборонено. -#}
{% extends "base.njk" %}
{%- set strings = strings[lang] | default(strings.uk) %}
{%- set title = item.data.title + " (not translated)" if item else title -%}
{%- set title_uk = item.data.title if item else (title_uk | default("")) -%}
{%- set summary = strings.stub.summary if item else summary -%}

{% block title %}<title>{{ title }} — {{ strings.site.name }}</title>{% endblock %}

{# Заглушка не є мовним дзеркалом: поза hreflang за DECISIONS §35.2. #}
{% block hreflang %}<link rel="canonical" href="https://koztechie.fyi{{ page.url }}">{% endblock %}

{% block description %}
{%- if summary %}
<meta name="description" content="{{ summary }}">
{%- endif %}
{% endblock %}

{% block content %}
{%- set raw = page.url if page.url else "/" -%}
{%- set ukHref = raw.slice(3) if raw.indexOf("/en/") === 0 else raw -%}
<article class="translation-pending">
  <h1>{{ strings.stub.title }}</h1>
  <p lang="uk">{{ title_uk }}</p>
  <p><a href="{{ ukHref }}" hreflang="uk">{{ strings.stub.link }} <span aria-hidden="true">→</span></a></p>
  {%- if raw.indexOf("/cemetery/") !== -1 %}
  <nav class="pagination entry-navigation" aria-label="{{ strings.post.navigation_label }}">
    <a href="/en/cemetery/">{{ strings.post.archive_project }}</a>
  </nav>
  {%- endif %}
</article>
{% endblock %}
