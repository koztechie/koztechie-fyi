{% extends "base.njk" %}
{%- set strings = strings[lang] | default(strings.uk) %}

{% block title %}<title>{{ title }} — {{ strings.site.name }}</title>{% endblock %}

{% block description %}
{%- if summary %}
<meta name="description" content="{{ summary }}">
{%- endif %}
{% endblock %}

{% block content %}
{%- set raw = page.url if page.url else "/" -%}
{%- set ukHref = raw.slice(3) if raw.indexOf("/en/") === 0 else raw -%}
<article class="translation-pending">
  <h1>{{ strings.stub.title }}</h1>
  <p><a href="{{ ukHref }}">{{ strings.stub.link }} <span aria-hidden="true">→</span></a></p>
  {%- if raw.indexOf("/cemetery/") !== -1 %}
  <nav class="pagination entry-navigation" aria-label="{{ strings.post.navigation_label }}">
    <a href="/en/cemetery/">{{ strings.post.archive_project }}</a>
  </nav>
  {%- endif %}
</article>
{% endblock %}
