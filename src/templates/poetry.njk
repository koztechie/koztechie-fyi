{#- Окремий шаблон вірша: розриви рядків зберігаються через .poetry. -#}
{% extends "base.njk" %}
{%- set strings = strings[lang] | default(strings.uk) %}

{% block title %}<title>{{ title }} — {{ strings.site.name }}</title>{% endblock %}

{% block og_type %}article{% endblock %}

{% block article_meta %}
<meta property="article:published_time" content="{{ date.toISOString() }}">
<meta property="article:author" content="https://koztechie.fyi/">
{% endblock %}

{% block description %}
<meta name="description" content="{{ summary }}">
{% endblock %}

{% block content %}
<article class="entry">
  <p class="entry-line">{{ strings.post.poem_entry_prefix }}{{ entry }}</p>
  <h1>{{ title }}</h1>
  {% if content_warning %}
   <aside class="content-warning" role="note">
    <p>{{ strings.post.warning_prefix }} {{ strings.post.warnings[content_warning] or content_warning }}.</p>
  </aside>
  {% endif %}
  <p class="entry-meta">
    <time datetime="{{ date.toISOString().slice(0, 10) }}">{% if (lang | default("uk")) === "en" %}{{ date | enDate }}{% else %}{{ date | ukDate }}{{ strings.site.date_suffix }}{% endif %}</time>
  </p>
  <div class="entry-body poetry">{{ content | trim | safe }}</div>
  {% if written or written_period %}
  <footer class="poem-colophon">
    <span class="poem-colophon__label">{{ strings.post.written_label }}</span>
    {% if written %}
    <time datetime="{{ written.toISOString().slice(0, 10) }}">{% if (lang | default("uk")) === "en" %}{{ written | enDate }}{% else %}{{ written | ukDate }}{% endif %}</time>
    {% else %}
    <span>{{ written_period }}</span>
    {% endif %}
  </footer>
  {% endif %}
  <nav class="pagination entry-navigation" aria-label="{{ strings.post.navigation_label }}">
    <a href="{% if (lang | default('uk')) === 'en' %}/en/poetry/{% else %}/poetry/{% endif %}">{{ strings.nav.poetry }}</a>
  </nav>
</article>
{% endblock %}
