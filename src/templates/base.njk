{#- base.njk: базовий шаблон усіх сторінок.
    Крок 105. docs/design-system.md §9.
    Мовна схема: DECISIONS.md §19. uk — корінь, en — /en/.
    Вибір словника (крок 117): {% set strings = strings[lang] | default(strings.uk) %}
    — КОЖЕН дочірній шаблон робить цей set після extends (set у батька
    не видимий у блоці дитини в Eleventy).
    Блоки для розширення: head, title, description, header, footer.
    Шапка: паршал header.njk (крок 108). Підвал: паршал footer.njk (крок 109). -#}
<!doctype html>
<html lang="{{ lang | default("uk") }}">
<head>
  <meta charset="utf-8">
  {#- Крок 106. viewport без maximum-scale/user-scalable=no
      (доступність, TECH_STANDARDS §9). -#}
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% block title %}<title>{{ (strings[lang] | default(strings.uk) | default(strings)).site.name }}</title>{% endblock %}
  {#- Опис за замовчуванням: коротка версія біо (DECISIONS.md §10, ~85 символів).
      Сторінки перевизначають блок description.
      Ланцюг fallback: дочірні шаблони роблять set strings (вибраний словник) —
      тоді strings[lang] і strings.uk вже undefined, і default повертає сам strings.
      Без set (strings = {uk,en}) — спрацьовує strings[lang]. -#}
  {% block description %}
  <meta name="description" content="{{ (strings[lang] | default(strings.uk) | default(strings)).site.bio_short }}">
  {% endblock %}
  {#- theme-color: ПАПІР #f7f8fa, БУНКЕР #0e1116 (§4.2).
      Два теги з media queries — тема визначається системою, без JS. -#}
  <meta name="theme-color" content="#f7f8fa" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#0e1116" media="(prefers-color-scheme: dark)">
  {#- RSS auto-discovery для обох фідів (TECH_STANDARDS §9, крок 125).
      Назва фіда — з самого каналу (<title>), не з атрибута лінка. -#}
  <link rel="alternate" type="application/rss+xml" href="https://koztechie.fyi/feed.xml">
  <link rel="alternate" type="application/rss+xml" href="https://koztechie.fyi/en/feed.xml">
  {#- Крок 112. hreflang + canonical (TECH_STANDARDS §9): взаємні, абсолютні,
      з self-reference. x-default — українська (коренева) версія, для головної
      це https://koztechie.fyi/ (DECISIONS.md §19.0).
      hreflang="en" НЕ вказує на noindex-заглушку «Not translated»:
      умова enPage.noindex (контракт для i18n, крок 117).
      404 перевизначає блок порожнім (§17.1: поза sitemap та hreflang). -#}
  {% block hreflang %}
  {%- set rawUrl = page.url | default("/") -%}
  {%- set isEn = rawUrl.indexOf("/en/") === 0 -%}
  {%- set ukPath = rawUrl.slice(3) if isEn else rawUrl -%}
  {%- set enPath = "/en" + ukPath -%}
  {%- set site = "https://koztechie.fyi" -%}
  {%- set enPage = collections.all | findByUrl(enPath) -%}
  <link rel="canonical" href="{{ site + rawUrl }}">
  <link rel="alternate" hreflang="uk" href="{{ site + ukPath }}">
  {%- if enPage and not enPage.data.noindex %}
  <link rel="alternate" hreflang="en" href="{{ site + enPath }}">
  {%- endif %}
  <link rel="alternate" hreflang="x-default" href="{{ site + ukPath }}">
  {% endblock %}
  {#- Open Graph (крок 148). Картинка — типографічна, палітра ПАПІР,
      1200×630 (static/og/home.png). Без кота (DECISIONS §13).
      og:image однакова для всіх сторінок поки немає картинок записів.
      og:title/og:description — блоки для перевизначення сторінками. -#}
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ (strings[lang] | default(strings.uk) | default(strings)).site.name }}">
  <meta property="og:title" content="{% block og_title %}{{ (strings[lang] | default(strings.uk) | default(strings)).site.name }}{% endblock %}">
  <meta property="og:description" content="{% block og_description %}{{ (strings[lang] | default(strings.uk) | default(strings)).site.bio_short }}{% endblock %}">
  <meta property="og:url" content="https://koztechie.fyi{{ page.url | default("/") }}">
  <meta property="og:image" content="https://koztechie.fyi/og/home.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:locale" content="{% if (lang | default('uk')) === 'en' %}en_US{% else %}uk_UA{% endif %}">
  <link rel="stylesheet" href="/styles/core.css">
  <link rel="stylesheet" href="/styles/layout.css">
  <link rel="stylesheet" href="/styles/components.css">
  <link rel="stylesheet" href="/styles/themes.css">
  <link rel="stylesheet" href="/styles/print.css">
  {% block head %}{% endblock %}
</head>
<body>
  {#- Skip-link (TECH_STANDARDS §63): перший елемент — клавіатурна навігація
      відразу до вмісту, оминаючи шапку. Видимий лише при фокусі (layout.css). -#}
  <a class="skip-link" href="#main">{{ (strings[lang] | default(strings.uk) | default(strings)).nav.skip }}</a>
  <header class="site-header">
    {% block header %}{% include "header.njk" %}{% endblock %}
  </header>

  <main id="main">
    {% block content %}{{ content | safe }}{% endblock %}
  </main>

  <footer class="site-footer">
    {% block footer %}{% include "footer.njk" %}{% endblock %}
  </footer>
</body>
</html>
