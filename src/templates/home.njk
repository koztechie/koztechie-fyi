{#- home.njk: лейаут головної.
    Крок 113. docs/design-system.md §9.1.
    Головна — обкладинка книги. Не стрічка. Не плитка.
    Три останніх записи — максимум. Решта — у /blog/.
    Сигнатури: мікрогліч на h1 (§7.2), .entry-line (§7.1).
    Тексти — з _data/strings (крок 119). Тимчасові дефолти — канон §9.1, §10.
    Колекції: blog (крок 69), manifest — через findByUrl (крок 111). -#}
{% extends "base.njk" %}

{% block content %}
<article class="home">
  <h1>ВУЗОЛ-0</h1>
  <p class="home-lead">{{ strings.home.lead | default("Архівний вузол. Текст без прикрас.") }}</p>

  {#- Уривок маніфесту: /manifest/ з колекції all.
      Без сторінки — блок мовчки приховується. -#}
  {%- set manifest = collections.all | findByUrl("/manifest/") -%}
  {%- if manifest %}
  <section class="home-manifest" aria-labelledby="home-manifest-h">
    <h2 id="home-manifest-h">{{ strings.home.manifest_title | default("Маніфест") }}</h2>
    <p>{{ manifest.data.summary or strings.home.manifest_lead | default("Перелік того, чим цей сайт ніколи не буде.") }}</p>
    <p><a href="/manifest/">{{ strings.home.manifest_link | default("→ /manifest/") }}</a></p>
  </section>
  {%- endif %}

  {#- Три останні записи: колекція blog (спаджено за датою, крок 69).
      Максимум три — loop.index0 < 3. Сигнатура .entry-line — номер entry. -#}
  {%- set latest = [] -%}
  {%- for post in collections.blog -%}
    {%- if loop.index0 < 3 %}{% set latest = latest.concat([post]) %}{% endif -%}
  {%- endfor -%}
  {%- if latest.length %}
  <section class="home-latest" aria-labelledby="home-latest-h">
    <h2 id="home-latest-h">{{ strings.home.latest_title | default("Останні записи") }}</h2>
    <ul class="archive-list">
      {%- for post in latest %}
      <li>
        <span class="entry-line">Запис №{{ post.data.entry }}</span>
        <a href="{{ post.url }}">{{ post.data.title }}</a>
        {%- if post.data.reading_time %}
        <span class="entry-meta">≈ {{ post.data.reading_time }} хв</span>
        {%- endif %}
      </li>
      {%- endfor %}
    </ul>
  </section>
  {%- endif %}
</article>
{% endblock %}
