{#- home.njk: лейаут головної.
    Впровадження «чотирьох тез»: 2026-10-26 (DECISIONS §1.7).
    Головна: герой (мета-рядок, теза, лід, лист, паспорт) → §1 тези →
    §2 розділи → §3 журнал → §4 маніфест/NICHLYST.
    Рядок документа з датою — у base.njk (усі сторінки).
    Сигнатури: мікрогліч на h1 (§7.2), .entry-line (§7.1).
    Тексти — зі словників. Хардкод заборонено (крок 118). -#}
{% extends "base.njk" %}
{%- set strings = strings[lang] | default(strings.uk) %}

{#- Meta description (крок 146): summary головної або дефолтне біо (§10).
      Бюджет: ≤ 155 символів (PLAN 146). -#}
{% block description %}
<meta name="description" content="{{ summary | default(strings.site.bio_short) }}">
{% endblock %}

{#- OG-опис (крок 148) — консистентний з meta description. -#}
{% block og_description %}{{ summary | default(strings.site.bio_short) }}{% endblock %}

{#- JSON-LD (крок 151, TECH_STANDARDS §9): Person + WebSite.
      Person.name — одне; решта форм в alternateName; sameAs — лише GitHub.
      Дані: _data/schema.json (DT: F-01 імʼя, F-02 псевдонім koztechie).
      Не виконуваний контент (type=application/ld+json) — check 7а робить
      виняток. -#}
{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "name": {{ schema.person.name | json | safe }},
      "alternateName": {{ schema.person.alternateName | json | safe }},
      "sameAs": {{ schema.person.sameAs | json | safe }}
    },
    {
      "@type": "WebSite",
      "name": {{ strings.site.name | json | safe }},
      "url": {{ schema.siteUrl | json | safe }},
      "description": {{ strings.site.title | json | safe }}
    }
  ]
}
</script>
{% endblock %}

{% block content %}
{%- set homeIsEn = (lang | default("uk")) === "en" -%}
{%- set pageLang = lang | default("uk") -%}
{#- Останнє оновлення контенту (теза 2: чесність = дата).
      Джерело — колекція uk; ISO у паспорті обома мовами. -#}
{%- set lastUpd = "" -%}
{%- set lastTs = 0 -%}
{%- for p in collections.uk -%}
  {%- set d = p.data.updated if p.data.updated else p.data.date -%}
  {%- if d and d.getTime -%}
    {%- set ts = d.getTime() -%}
    {%- if ts > lastTs -%}{%- set lastTs = ts -%}{%- set lastUpd = d -%}{%- endif -%}
  {%- endif -%}
{%- endfor -%}
<article class="home">
  {#- Герой: мета-рядок → теза → лід → єдиний заклик (теза 3) → паспорт. -#}
  <div class="home-hero">
    <p class="meta-line">
      {%- for m in strings.home.meta -%}
      {{ m }}{% if not loop.last %}<span class="sep" aria-hidden="true"> · </span>{% endif %}
      {%- endfor -%}
    </p>
    <h1>{{ strings.home.thesis }}</h1>
    <p class="home-lead">{{ strings.home.lead }}</p>

    {#- Лист — єдиний канал зворотного зв'язку (§1.1: окрім email немає
        нічого; дзеркало /en/contact/ за шаблоном секцій). -#}
    {%- set ctaHref = "/contact/" -%}
    {%- if homeIsEn -%}
      {%- set ctaCand = "/en/contact/" -%}
      {%- if collections.all | findByUrl(ctaCand) %}{% set ctaHref = ctaCand %}{% endif -%}
    {%- endif -%}
    <p class="letter-cta">
      <a href="{{ ctaHref }}">{{ strings.home.cta_text }}</a>
      <span class="letter-note">{{ strings.home.cta_note }}</span>
    </p>

    <aside class="passport" aria-label="{{ strings.home.passport_label }}">
      {#- Дані паспорта — з вимірювань, не зі слів: Мови/Сторінки/Оновлено
          рахуються з колекцій, Вага міряється після рендера (eleventy.after,
          якір .passw). У словнику — лише мітки та одиниці. -#}
      <dl>
        <div class="row"><dt>{{ strings.home.pass_label_author }}</dt><dd>{{ strings.home.pass_value_author }}</dd></div>
        <div class="row"><dt>{{ strings.home.pass_label_alias }}</dt><dd>{{ strings.home.pass_value_alias }}</dd></div>
        <div class="row"><dt>{{ strings.home.pass_label_lang }}</dt><dd>{{ (collections.uk.length > 0) + (collections.en.length > 0) }}</dd></div>
        <div class="row"><dt>{{ strings.home.pass_label_pages }}</dt><dd>{{ collections.uk.length + collections.en.length + 1 }}</dd></div>
        <div class="row"><dt>{{ strings.home.pass_label_weight }}</dt><dd><span class="passw"></span> {{ strings.home.pass_weight_unit }}</dd></div>
        {%- if lastUpd %}
        <div class="row"><dt>{{ strings.home.doc_updated }}</dt><dd class="hl">{{ lastUpd | isoDate }}</dd></div>
        {%- endif %}
      </dl>
    </aside>
  </div>

  {#- §1. Основа: чотири тези (DECISIONS §1.7). Нумерація 01–04. -#}
  <section aria-labelledby="home-theses-h">
    <p class="eyebrow"><span class="sec">§1</span> · {{ strings.home.eyebrow_base }}</p>
    <h2 id="home-theses-h">{{ strings.home.theses_title }}</h2>
    <ol class="home-theses">
      {%- for t in strings.home.theses %}
      <li>
        <span class="num">{{ "0" + loop.index }}</span>
        <span class="name">{{ t.title }}</span>
        <span class="desc">{{ t.text }}</span>
      </li>
      {%- endfor %}
    </ol>
  </section>

  {#- §2. Розділи: карта сайту за sitemap (9 розділів, без Головної).
      Моно-нумерація — CSS counter (§5.8.3). Лінки мовно-залежні:
      en-дерево з fallback на uk. -#}
  <section aria-labelledby="home-sections-h">
    <p class="eyebrow"><span class="sec">§2</span> · {{ strings.home.eyebrow_content }}</p>
    <h2 id="home-sections-h">{{ strings.home.sections_title }}</h2>
    <ol class="home-sections-list">
      {%- set sectionsNav = [
        { href: "/manifest/", key: "manifest" },
        { href: "/practice/", key: "practice" },
        { href: "/cemetery/", key: "cemetery" },
        { href: "/blog/", key: "blog" },
        { href: "/poetry/", key: "poetry" },
        { href: "/nichlyst/", key: "nichlyst" },
        { href: "/now/", key: "now" },
        { href: "/colophon/", key: "colophon" },
        { href: "/contact/", key: "contact" }
      ] -%}
      {%- for item in sectionsNav %}
      {%- set itemHref = item.href -%}
      {%- if homeIsEn -%}
        {%- set cand = "/en" + item.href -%}
        {%- if collections.all | findByUrl(cand) %}{% set itemHref = cand %}{% endif -%}
      {%- endif -%}
      <li><a href="{{ itemHref }}">{{ strings.nav[item.key] }}</a></li>
      {%- endfor %}
    </ol>
  </section>

  {#- §3. Журнал: три останні записи колекції blog (спаджено за датою).
      Фільтри: мова, наявність date, не чернетка. Сигнатура .entry-line. -#}
  {%- set latest = [] -%}
  {%- for post in collections.blog -%}
    {%- if post.data.draft !== true and post.data.date and post.url and (post.data.lang | default("uk")) === pageLang and latest.length < 3 %}{% set latest = latest.concat([post]) %}{% endif -%}
  {%- endfor -%}
  {%- if latest.length %}
  <section aria-labelledby="home-latest-h">
    <p class="eyebrow"><span class="sec">§3</span> · {{ strings.home.eyebrow_log }}</p>
    <h2 id="home-latest-h">{{ strings.home.latest_title }}</h2>
    <ul class="archive-list">
      {%- for post in latest %}
      <li>
        <span class="entry-line">{{ strings.post.entry_prefix }}{{ post.data.entry }}</span>
        <a href="{{ post.url }}">{{ post.data.title }}</a>
        {%- if post.templateContent %}
        <span class="entry-meta">≈ {{ post.templateContent | readingTime }} {{ strings.post.reading_time_unit }}</span>
        {%- endif %}
      </li>
      {%- endfor %}
    </ul>
  </section>
  {%- endif %}

  {#- §4. Правила + проєкт: уривок маніфесту (мовне дзеркало, крок 150)
      і один рядок NICHLYST (§21.1: анкор, без голого URL). -#}
  {%- set manifestPath = "/en/manifest/" if homeIsEn else "/manifest/" -%}
  {%- set manifest = collections.all | findByUrl(manifestPath) -%}
  {%- set nichlystHref = "/nichlyst/" -%}
  {%- if homeIsEn -%}
    {%- set nichlystCand = "/en/nichlyst/" -%}
    {%- if collections.all | findByUrl(nichlystCand) %}{% set nichlystHref = nichlystCand %}{% endif -%}
  {%- endif -%}
  <section class="home-duo">
    {%- if manifest %}
    <div class="home-duo-cell">
      <p class="eyebrow"><span class="sec">§4</span> · {{ strings.home.eyebrow_rules }}</p>
      <h2>{{ strings.home.manifest_title }}</h2>
      <p>{{ manifest.data.summary or strings.home.manifest_lead }}</p>
      <p><a href="{{ manifestPath }}">{{ strings.home.manifest_link }}</a></p>
    </div>
    {%- endif %}
    <div class="home-duo-cell">
      <p class="eyebrow">{{ strings.home.eyebrow_project }}</p>
      <h2>{{ strings.nav.nichlyst }}</h2>
      <p>{{ strings.home.nichlyst_lead }} <a href="{{ nichlystHref }}">{{ strings.nav.nichlyst }}</a>.</p>
    </div>
  </section>
</article>
{% endblock %}
