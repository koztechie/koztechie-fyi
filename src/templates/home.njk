{#- home.njk: лейаут головної.
    Структура за спеком автора: 2026-11-05 (фінальна редакція, §6).
    Головна: герой (мета-рядок, теза, лід, лист) → Про автора і сайт (паспорт) →
    Основні принципи (DECISIONS §1.7) → Що тут є → Останні записи →
    Головний проєкт (NICHLYST). Блок маніфесту прибрано (повтор теми).
    Паспорт рахується, не лежить у словнику: мови — з наявних мовних дерев,
    сторінки — з колекцій, дата — максимум date/updated. Обсяг — ліміт
    TECH_STANDARDS §1. Сигнатури: мікрогліч на h1 (§7.2), .entry-line (§7.1).
    Тексти — зі словників. Хардкод заборонено (крок 118). -#}
{% extends "base.njk" %}
{%- set strings = strings[lang] | default(strings.uk) %}

{#- Meta description (крок 146): summary головної або дефолтне біо (§10).
      Бюджет: ≤ 155 символів (PLAN 146). -#}
{% block description %}
<meta name="description" content="{{ summary | default(strings.site.bio_short) }}">
{% endblock %}

{#- OG-опис (крок 148) — консистентний з meta description. -#}
{% block og_description %}{{ summary | default(strings.site.bio_short) }}{% endblock %}

{#- JSON-LD (крок 151, TECH_STANDARDS §9): Person + WebSite.
      Person.name — одне; решта форм в alternateName; sameAs — лише GitHub.
      Дані: _data/schema.json (DT: F-01 імʼя, F-02 псевдонім koztechie).
      Не виконуваний контент (type=application/ld+json) — check 7а робить
      виняток. -#}
{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "name": {{ schema.person.name | json | safe }},
      "alternateName": {{ schema.person.alternateName | json | safe }},
      "sameAs": {{ schema.person.sameAs | json | safe }}
    },
    {
      "@type": "WebSite",
      "name": {{ strings.site.name | json | safe }},
      "url": {{ schema.siteUrl | json | safe }},
      "description": {{ strings.site.title | json | safe }}
    }
  ]
}
</script>
{% endblock %}

{% block content %}
{%- set homeIsEn = (lang | default("uk")) === "en" -%}
{%- set pageLang = lang | default("uk") -%}
{#- Останнє оновлення контенту (теза 2: чесність = дата).
      Джерело — колекція uk; у паспорті — локалізована дата (ukDate/enDate). -#}
{%- set lastUpd = "" -%}
{%- set lastTs = 0 -%}
{%- for p in collections.uk -%}
  {%- set d = p.data.updated if p.data.updated else p.data.date -%}
  {%- if d and d.getTime -%}
    {%- set ts = d.getTime() -%}
    {%- if ts > lastTs %}{%- set lastTs = ts %}{%- set lastUpd = d -%}{%- endif -%}
  {%- endif -%}
{%- endfor -%}
<article class="home">
  {#- Герой: мета-рядок → теза → лід → єдиний заклик (теза 3). -#}
  <div class="home-hero">
    <p class="meta-line">
      {%- for m in strings.home.meta -%}
      {{ m }}{% if not loop.last %}<span class="sep" aria-hidden="true"> · </span>{% endif %}
      {%- endfor %}
    </p>
    <h1>{{ strings.home.thesis }}</h1>
    <p class="home-lead">{{ strings.home.lead }}</p>

    {#- Лист — єдиний канал зворотного зв'язку (§1.1: окрім email немає
        нічого; дзеркало /en/contact/ за шаблоном секцій). -#}
    {%- set ctaHref = "/contact/" -%}
    {%- if homeIsEn -%}
      {%- set ctaCand = "/en/contact/" -%}
      {%- if collections.all | findByUrl(ctaCand) %}{% set ctaHref = ctaCand %}{% endif -%}
    {%- endif -%}
    <p class="letter-cta">
      <a href="{{ ctaHref }}">{{ strings.home.cta_text }}</a>
      <span class="letter-note">{{ strings.home.cta_note }}</span>
    </p>
  </div>

  {#- Коротко про сайт: паспорт видимим заголовком (спек 2026-11-05).
      Мови — назви тих дерев, що мають контент; сторінки — з колекцій;
      дата — максимум date/updated (§27); розмір — ліміт §1. -#}
  <section aria-labelledby="home-cabinet-h">
    <h2 id="home-cabinet-h">{{ strings.home.passport_label }}</h2>
    {%- set langList = [] -%}
    {%- if collections.uk.length %}{% set langList = langList.concat([strings.home.lang_names.uk]) %}{% endif -%}
    {%- if collections.en.length %}{% set langList = langList.concat([strings.home.lang_names.en]) %}{% endif -%}
    <div class="passport">
      <dl>
        <div class="row"><dt>{{ strings.home.pass_label_author }}</dt><dd>{{ strings.home.pass_value_author }}</dd></div>
        <div class="row"><dt>{{ strings.home.pass_label_alias }}</dt><dd>{{ strings.home.pass_value_alias }}</dd></div>
        <div class="row"><dt>{{ strings.home.pass_label_lang }}</dt><dd>{{ langList | join(", ") }}</dd></div>
        <div class="row"><dt>{{ strings.home.pass_label_pages }}</dt><dd>{{ collections.uk.length + collections.en.length + 1 }}</dd></div>
        <div class="row"><dt>{{ strings.home.pass_label_size }}</dt><dd>{{ strings.home.pass_size }}</dd></div>
        {%- if lastUpd %}
        <div class="row"><dt>{{ strings.home.doc_updated }}</dt><dd class="hl">{% if pageLang === "en" %}{{ lastUpd | enDate }}{% else %}{{ lastUpd | ukDate }}{{ strings.site.date_suffix }}{% endif %}</dd></div>
        {%- endif %}
      </dl>
    </div>
  </section>

  {#- Основні принципи (DECISIONS §1.7). Нумерація 01–04. -#}
  <section aria-labelledby="home-principles-h">
    <h2 id="home-principles-h">{{ strings.home.principles_title }}</h2>
    <ol class="home-principles">
      {%- for t in strings.home.principles %}
      <li>
        <span class="num">{{ "0" + loop.index }}</span>
        <span class="name">{{ t.title }}</span>
        <span class="desc">{{ t.text }}</span>
      </li>
      {%- endfor %}
    </ol>
  </section>

  {#- Що тут є: карта сайту за sitemap (9 розділів, без Головної).
      Описи — зі словників; лінки мовно-залежні: en-дерево з fallback на uk. -#}
  <section aria-labelledby="home-sections-h">
    <h2 id="home-sections-h">{{ strings.home.sections_title }}</h2>
    <ul class="home-sections-list">
      {%- set sectionsNav = [
        { href: "/manifest/", key: "manifest" },
        { href: "/practice/", key: "practice" },
        { href: "/cemetery/", key: "cemetery" },
        { href: "/blog/", key: "blog" },
        { href: "/poetry/", key: "poetry" },
        { href: "/nichlyst/", key: "nichlyst" },
        { href: "/now/", key: "now" },
        { href: "/colophon/", key: "colophon" },
        { href: "/contact/", key: "contact" }
      ] -%}
      {%- for item in sectionsNav %}
      {%- set itemHref = item.href -%}
      {%- if homeIsEn -%}
        {%- set cand = "/en" + item.href -%}
        {%- if collections.all | findByUrl(cand) %}{% set itemHref = cand %}{% endif -%}
      {%- endif %}
      <li><a href="{{ itemHref }}">{{ strings.nav[item.key] }}</a> — {{ strings.home.sections_desc[item.key] }}</li>
      {%- endfor %}
    </ul>
  </section>

  {#- Останні записи: до трьох останніх записів колекції blog (спаджено за
      датою). Без нумерації: «Назва · Приблизно N хвилин читання.»
      (спек 2026-11-05, §6). Фільтри: мова, наявність date, не чернетка. -#}
  {%- set latest = [] -%}
  {%- for post in collections.blog -%}
    {%- if post.data.draft !== true and post.data.date and post.url and (post.data.lang | default("uk")) === pageLang and latest.length < 3 %}{% set latest = latest.concat([post]) %}{% endif -%}
  {%- endfor -%}
  {%- if latest.length %}
  <section aria-labelledby="home-latest-h">
    <h2 id="home-latest-h">{{ strings.home.latest_title }}</h2>
    <ul class="archive-list">
      {%- for post in latest %}
      {%- set mins = post.templateContent | readingTime %}
      <li>
        <a href="{{ post.url }}">{{ post.data.title }}</a>
        <span class="sep" aria-hidden="true"> · </span>
        <span class="entry-meta">{{ strings.post.reading_prefix }} {{ mins }} {{ mins | plural(strings.post.reading_forms) }}{{ strings.post.reading_suffix }}.</span>
      </li>
      {%- endfor %}
    </ul>
  </section>
  {%- endif %}

  {#- Головний проєкт: текст і окремий вихід (спек 2026-11-05, §6).
      Блок «Навіщо цей сайт» прибрано — маніфест є в переліку розділів. -#}
  {%- set nichlystHref = "/nichlyst/" -%}
  {%- if homeIsEn -%}
    {%- set nichlystCand = "/en/nichlyst/" -%}
    {%- if collections.all | findByUrl(nichlystCand) %}{% set nichlystHref = nichlystCand %}{% endif -%}
  {%- endif -%}
  <section aria-labelledby="home-nichlyst-h">
    <h2 id="home-nichlyst-h">{{ strings.home.nichlyst_section_title }}</h2>
    <h3>{{ strings.nav.nichlyst }}</h3>
    <p>{{ strings.home.nichlyst_text }}</p>
    <p><a href="{{ nichlystHref }}">{{ strings.home.nichlyst_link }}</a></p>
  </section>
</article>
{% endblock %}
