---
pagination:
  data: feedLangs
  size: 1
  alias: feedLang
permalink: "{% if feedLang == \"en\" %}/en/feed.xml{% else %}/feed.xml{% endif %}"
eleventyExcludeFromCollections: true
---
{#- feed.njk: два RSS-фіди — /feed.xml (uk) та /en/feed.xml (en).
    Крок 125. DECISIONS.md §30, §17.3, ARCHITECTURE.md.
    Повні тексти (§30.1): <description> = весь HTML запису, без обрізок.
    Весь архів (§30.3): /blog/, /practice/, /poetry/, /cemetery/ — без лімітів.
    <guid> = <link> (§30.4). <pubDate> — RFC 822 (фільтр rfc822Date).
    Без реклами, відстеження, соцмереж, «Читати далі» (§30.3).
    Мовна ізоляція: items лише цієї мови.
    autoescape njk екранує <title>/<description>; CDATA потребує | safe.
    Пагінація на feedLangs (глобальні дані): вбудований масив Eleventy
    у pagination.data не підтримується. -#}
{%- set strings = strings[feedLang] | default(strings.uk) -%}
{%- set siteRoot = "https://koztechie.fyi" -%}
{%- set sections = ["/blog/", "/practice/", "/poetry/", "/cemetery/"] -%}
{%- set items = [] -%}
{%- for item in collections.all -%}
  {%- set u = item.url if item.url else "" -%}
  {%- set inSection = false -%}
  {%- for s in sections -%}{%- if u.indexOf(s) >= 0 or u.indexOf("/en" + s) >= 0 %}{% set inSection = true %}{% endif -%}{%- endfor -%}
  {%- if inSection and item.data.date and not item.data.noindex and item.data.draft !== true and (item.data.lang | default("uk")) === feedLang and u -%}
    {%- set items = items.concat([item]) -%}
  {%- endif -%}
{%- endfor -%}
{%- set items = items | sortByDateDesc -%}
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0">
  <channel>
    <title>{{ strings.site.name }}</title>
    <link>{% if feedLang === "en" %}{{ siteRoot }}/en/{% else %}{{ siteRoot }}/{% endif %}</link>
    <description>{{ strings.site.title }}</description>
    <language>{{ feedLang }}</language>
    <lastBuildDate>{{ page.date | rfc822Date }}</lastBuildDate>
    {%- for item in items %}
    {%- set u = item.url if item.url else "" %}
    <item>
      <title>{{ item.data.title }}</title>
      <link>{{ siteRoot }}{{ u }}</link>
      <guid isPermaLink="true">{{ siteRoot }}{{ u }}</guid>
      <pubDate>{{ item.data.date | rfc822Date }}</pubDate>
      <description><![CDATA[{{ item.templateContent | safe }}]]></description>
    </item>
    {%- endfor %}
  </channel>
</rss>
