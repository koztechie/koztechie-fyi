---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
{#- sitemap.njk: карта сайту обох мов.
    Крок 121. docs/DECISIONS.md §17.4, ARCHITECTURE.md.
    Одна сторінка /sitemap.xml містить обидві мови (§19.3).
    Правила включення:
    - лише сторінки (URL завершується на /);
    - без noindex (заглушки «Not translated», ARCHITECTURE §4);
    - без /404 (§17.4);
    - без самого sitemap (не HTML-сторінка).
    lastmod: updated або date, ISO 8601 (§20).
    Без <priority> та <changefreq> (§17.4). -#}
{%- set origin = "https://koztechie.fyi" -%}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- set entries = [] -%}
{%- for item in collections.publicPages | sortByUrl -%}
  {%- set raw = item.url -%}
  {%- set isEn = raw.indexOf("/en/") === 0 -%}
  {%- set ukPath = raw.slice(3) if isEn else raw -%}
  {%- set enPath = "/en" + ukPath -%}
  {%- set ukPage = collections.all | findByUrl(ukPath) -%}
  {%- set enPage = collections.all | findByUrl(enPath) -%}
  {%- if ukPage and enPage and not ukPage.data.noindex and not enPage.data.noindex -%}
    {%- set mod = item.data.updated or item.data.date -%}
    {%- set lastmod = mod | isoDate -%}
    {%- set entries = entries.concat([{ url: item.url, ukPath: ukPath, enPath: enPath, lastmod: lastmod }]) -%}
  {%- endif -%}
{%- endfor -%}
{%- for e in entries %}
  <url>
    <loc>{{ origin }}{{ e.url }}</loc>
    <xhtml:link rel="alternate" hreflang="uk" href="{{ origin }}{{ e.ukPath }}"/>
    <xhtml:link rel="alternate" hreflang="en" href="{{ origin }}{{ e.enPath }}"/>
    {%- if e.lastmod %}
    <lastmod>{{ e.lastmod }}</lastmod>
    {%- endif %}
  </url>
{%- endfor %}
</urlset>
